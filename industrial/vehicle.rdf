<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/v0cn037/ontologies/2026/10/vehicle/"
     xml:base="http://www.semanticweb.org/v0cn037/ontologies/2026/10/vehicle/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
