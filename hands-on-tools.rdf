    <!-- http://www.semanticweb.org/xiaoqi/ontologies/2026/3/hands-on-tools#Umi-OCR -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/xiaoqi/ontologies/2026/3/hands-on-tools#Umi-OCR">
        <rdf:type rdf:resource="http://www.semanticweb.org/xiaoqi/ontologies/2026/3/hands-on-tools#OCR"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/hiroi-sora/Umi-OCR/tree/main</rdfs:comment>
        <rdfs:comment>Free, Open-source, Batch Offline OCR Software
Compatible with Windows7 x64 and above

Free: All the code of this project is open-source and completely free.
Convenient: Unzip and use, run offline, no need for network.
Efficient: Comes with a highly efficient offline OCR engine. As long as the computer performance is sufficient, it can be faster than online OCR services.
Flexible: Supports customizable interface, and supports multiple calling methods such as command-line and HTTP API.</rdfs:comment>
    </owl:NamedIndividual>
    


